# ECLADO payment API（Vultr）環境變數範本。實際值放在主機的 .env，切勿提交。

PORT=3000

# 豐收款 API 位址：
#   Sandbox：https://apisbx.sinopac.com/funBIZ-Sbx/QPay.WebAPI/api
#   正式：  https://api.sinopac.com/funBIZ/QPay.WebAPI/api
SINOPAC_API_BASE_URL=https://apisbx.sinopac.com/funBIZ-Sbx/QPay.WebAPI/api

# 商店編號與金鑰（永豐提供，A1,A2,B1,B2 + X-Key）
SINOPAC_SHOP_NO=
SINOPAC_X_KEY=
SINOPAC_A1=
SINOPAC_A2=
SINOPAC_B1=
SINOPAC_B2=

# 本服務對外網址（ReturnURL / BackendURL 用）
PAYMENT_PUBLIC_URL=https://pay.ecladotaiwan.com

# Supabase（更新訂單狀態）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 逾期訂單清理端點的保護金鑰（必填；建議使用至少 32 bytes 的隨機值）
ORDER_CLEANUP_KEY=

# 標記已付款後轉發通知給 Vercel 端發 LINE／Email（選填，預設 www.ecladotaiwan.com）
# PAYMENT_NOTIFY_FORWARD_URL=https://www.ecladotaiwan.com/api/sinopac/notify
