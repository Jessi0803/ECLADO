{
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "RUN_STAGING_INTEGRATION=1 RUN_PAYMENT_INTEGRATION=1 playwright test tests/integration --project=chromium",
    "test:line": "node --test tests/integration/line-handler.test.cjs tests/integration/line-webhook.test.cjs",
    "test:cron": "node --test tests/integration/cancel-expired-orders.test.cjs",
    "test:transactions": "node --test tests/integration/sinopac-notify.test.cjs tests/integration/sinopac-notify-crypto.test.cjs tests/integration/remind-unpaid-orders.test.cjs tests/integration/cancel-expired-orders.test.cjs && npm --prefix payment-api test",
    "test:notify:real": "NOTIFY_TEST_DB_MODE=supabase node scripts/real-notification-test.cjs",
    "test:notify:real:mock": "node scripts/real-notification-test.cjs"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "vite": "^7.0.0"
  }
}
